    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">See what’s<br><em>on the menu.</em></h1>
        <p class="hero-description">Snap a restaurant menu and see every dish pictured. The original names, descriptions and prices stay with the menu.</p>
        <div class="hero-actions">
          <a href="/create" class="btn primary"><span data-icon="camera"></span> Upload a menu</a>
          <a href="/explore" class="btn quiet"><span data-icon="book"></span> Explore menus</a>
        </div>
        <p class="hero-note"><span data-icon="globe"></span> Every finished menu is shared with the community.</p>
      </div>
      <figure class="hero-figure">
        <div class="hero-photo"><img class="hero-image" src="/images/hero.webp" alt="Pappardelle with slow-cooked ragù, parmesan and fresh basil" fetchpriority="high" width="1450" height="967"></div>
        <span class="photo-badge"><span data-icon="sparkles"></span> AI illustration</span>
        <figcaption><span class="hero-caption-icon" data-icon="utensils"></span><strong>Pappardelle al ragù</strong></figcaption>
      </figure>
    </section>
    <section class="section" id="recent-menus" aria-labelledby="recent-title">
      <div class="section-top">
        <h2 id="recent-title">Published menus</h2>
        <a class="text-link" href="/explore">Search menus</a>
      </div>
      <div class="dish-grid" id="recent-grid"><%= render partial:"menus/card",collection:@menus,as: :menu %><% if @menus.empty? %><p class="muted">No menus published yet.</p><% end %></div>
    </section>
    <section class="section how" id="how" aria-labelledby="how-title">
      <div class="section-top"><div><p class="eyebrow">FROM PAPER TO PICTURE</p><h2 id="how-title">How it works</h2></div><a href="/create" class="btn quiet">Create a menu</a></div>
      <div class="how-grid">
        <article><span data-icon="camera"></span><h3>Snap the menu</h3><p>Take a clear photo or upload the pages you want to share.</p></article>
        <article><span data-icon="pin"></span><h3>Find the restaurant</h3><p>Choose the branch or enter its address, then select Generate &amp; publish.</p></article>
        <article><span data-icon="globe"></span><h3>Share it</h3><p>Menu Lens reads the prices, illustrates the dishes and publishes a link you can share.</p></article>
      </div>
    </section>
