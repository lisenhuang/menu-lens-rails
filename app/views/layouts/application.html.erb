<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f4ed" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#171e1a" media="(prefers-color-scheme: dark)">
  <meta name="description" content="Turn a photo of a restaurant menu into a visual menu, with the original dishes and prices intact.">
  <meta property="og:site_name" content="<%= @title || 'Menu Lens' %>">
  <meta property="og:title" content="<%= @title || 'Menu Lens' %>">
  <meta property="og:description" content="See what's on the menu. Turn a printed menu into a visual one.">
  <meta property="og:image" content="https://menu.9l.nz<%= @image || '/images/hero.webp' %>">
  <title><%= @title ? "#{@title} · Menu Lens" : "Menu Lens · See what’s on the menu" %></title>
  <link rel="icon" href="/mark.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin>
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/style.css?v=18">
  <meta name="turbo-cache-control" content="no-cache">
  <% if @workspace %><meta name="turbo-visit-control" content="reload"><% end %>
  <script type="module" src="/application.js?v=1" data-turbo-track="reload"></script>
</head>
<body data-controller="shell" <%= 'data-turbo="false"'.html_safe if @workspace %>>
  <a href="#main" class="skip">Skip to content</a>
  <header class="header">
    <div class="shell header-inner">
      <a href="/" class="brand" aria-label="Menu Lens home"><img src="/mark.svg" alt="" width="36" height="36"><span>menu<span class="brand-accent">lens</span><i>.</i></span></a>
      <nav aria-label="Main navigation">
        <a href="/explore">Explore menus</a>
        <a href="/#how">How it works</a>
      </nav>
      <div class="header-actions">
        <details class="theme">
          <summary aria-label="Change theme" title="Change theme"><span data-icon="sunMoon"></span></summary>
          <fieldset class="theme-options">
            <legend class="sr-only">Appearance</legend>
            <label><input type="radio" name="theme" value="system" aria-label="System"><span data-icon="sunMoon"></span>System<span data-icon="check"></span></label>
            <label><input type="radio" name="theme" value="light" aria-label="Light"><span data-icon="sun"></span>Light<span data-icon="check"></span></label>
            <label><input type="radio" name="theme" value="dark" aria-label="Dark"><span data-icon="moon"></span>Dark<span data-icon="check"></span></label>
          </fieldset>
        </details>
        <a class="btn small primary header-create" href="/create"><span data-icon="plus"></span> Create menu</a>
      </div>
    </div>
  </header>
  <main id="main" class="shell">
    <%= yield %>
  </main>
  <footer class="footer"><div class="shell">
    <a href="/" class="brand"><img src="/mark.svg" alt="" width="30" height="30"><span>menu<span class="brand-accent">lens</span><i>.</i></span></a>
    <p>Made in Aotearoa, for curious diners.</p>
    <nav aria-label="Footer">
      <a href="/explore">Explore menus</a>
      <a href="/privacy">Privacy &amp; data credits</a>
      <a class="source-link" href="https://github.com/lisenhuang/menu-lens-rails" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"/></svg>
        Source code</a>
    </nav>
  </div></footer>
  <dialog id="modal"></dialog>
  <dialog id="image-viewer" aria-label="Full-screen image">
    <div class="image-stage">
      <img alt="">
      <button type="button" class="icon-button" aria-label="Close full-screen image" autofocus><span data-icon="close"></span></button>
    </div>
  </dialog>
  <div id="toast" class="toast" role="status" hidden></div>
</body>
</html>
